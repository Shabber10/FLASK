# =========================================================================
# Enterprise Flask Masterclass - Environment Variables Template
# Copy this file to .env and configure values before starting services
# =========================================================================

# Flask Environment (development, testing, production)
FLASK_ENV=development
PORT=5000

# Security Secrets (Must generate high-entropy 32+ char strings in production)
SECRET_KEY=change-this-in-production-to-a-super-secret-random-key-123456
JWT_SECRET_KEY=change-this-in-production-to-a-super-secret-jwt-key-987654

# Token Expiration Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Database Configuration (PostgreSQL in production, SQLite fallback in local)
DATABASE_URL=postgresql://flaskuser:flaskpassword@localhost:5432/flaskdb
# DATABASE_URL=sqlite:///capstone.db

# Cache & Redis Broker
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=RedisCache

# Celery Background Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting Storage
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Media Uploads & File Storage
UPLOAD_FOLDER=capstone/uploads
MAX_CONTENT_LENGTH=16777216

# Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=true
